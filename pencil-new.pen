                          "fill": "$gsu-gold-bright"
                        },
                        {
                          "type": "text",
                          "id": "bEgXD",
                          "name": "T",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "“You haven't turned in your homework and your grades dropped. What's going on?”",
