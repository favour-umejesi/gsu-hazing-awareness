                    {
                      "type": "frame",
                      "id": "qT4Eq",
                      "name": "Q",
                      "width": "fill_container",
                      "fill": "$surface-cream",
                      "cornerRadius": 10,
                      "gap": 14,
                      "padding": 24,
                      "children": [
                        {
                          "type": "icon",
                          "id": "Sn4DR",
                          "name": "Quote",
