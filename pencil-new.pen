                        {
                          "type": "text",
                          "id": "eFU0J",
                          "name": "T",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "“I noticed you missed last night's meeting. You look tired and in pain — is everything ok?”",
                          "lineHeight": 1.45,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "MvqEU",
                      "name": "Q",
                      "width": "fill_container",
                      "fill": "$surface-cream",
                      "cornerRadius": 10,
                      "gap": 14,
                      "padding": 24,
                      "children": [
                        {
                          "type": "icon",
                          "id": "DSRki",
                          "name": "Quote",
                          "width": 22,
                          "height": 24,
                          "icon": "message-circle",
                          "library": "lucide",
                          "fill": "$gsu-gold-bright"
                        },
                        {
                          "type": "text",
                          "id": "M9RQoX",
                          "name": "T",
                          "fill": "$text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "“I saw you wearing a funny outfit in class today. Did someone force you to wear that?”",
                          "lineHeight": 1.45,
                          "fontFamily": "$font-body",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
