              "children": [
                {
                  "type": "frame",
                  "id": "gS5M1",
                  "name": "Row",
                  "width": "fill_container",
                  "gap": 20,
                  "children": [
                    {
                      "type": "frame",
                      "id": "FSmyx",
                      "name": "Q",
                      "width": "fill_container",
                      "fill": "$surface-cream",
                      "cornerRadius": 10,
                      "gap": 14,
                      "padding": 24,
                      "children": [
                        {
                          "type": "icon",
                          "id": "Q652nQ",
                          "name": "Quote",
                          "width": 22,
                          "height": 24,
